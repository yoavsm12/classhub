# ==============================================================================
# ClassHub — משתני סביבה
# העתיקו קובץ זה ל-.env.local ומלאו את הערכים האמיתיים.
# .env.local לא נשמר ב-git (ראה .gitignore).
# ==============================================================================

# --- Supabase --------------------------------------------------------------
# מהגדרות הפרויקט ב-Supabase: Project Settings → API
# ה-URL של הפרויקט
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# מפתח פומבי (publishable) — בטוח לחשיפה בדפדפן
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# מפתח סודי (secret) — שרת בלבד! אסור לחשוף בדפדפן ואסור להעלות ל-git.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Admin -------------------------------------------------------------------
# כתובת האימייל היחידה שמקבלת הרשאות ניהול (המשתמש נוצר ידנית ב-Supabase Auth).
ADMIN_EMAIL=teacher@example.com

# --- Guest / כניסת תלמידים ----------------------------------------------------
# Hash מוצפן (bcrypt) של קוד הגישה של הכיתה. אין לשים כאן את הקוד הגולמי!
# ליצירה: npm run generate-access-code-hash -- "הקוד-שלכם"
# ⚠️ חשוב: הפקודה למעלה כבר מדפיסה את השורה עם "\$" (קו נטוי לפני כל $) —
# חובה להעתיק אותה בדיוק ככה. Next.js מרחיב $VAR בקבצי env, ובלי הבריחה
# הזו ה-hash נקטע בשקט וההתחברות נכשלת תמיד עם "קוד גישה שגוי".
GUEST_ACCESS_CODE_HASH=

# מפתח סודי לחתימת ה-session של אורחים. מחרוזת אקראית וארוכה (32+ תווים).
# ליצירה מהירה: openssl rand -hex 32
GUEST_SESSION_SECRET=
